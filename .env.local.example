# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default -- never commit real keys.

# PayPal (see comment at top of src/components/PayPalButton.tsx for setup steps)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_HOSTED_BUTTON_ID=

# Supabase (only needed once the site has a dynamic feature -- not required to launch)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key -- SERVER-ONLY, bypasses Row Level Security.
# Used exclusively by src/app/api/webhooks/paypal/route.ts. Never prefix
# with NEXT_PUBLIC_, never import it from a client component. Get it from
# Supabase dashboard -> Settings -> API -> service_role (keep secret).
SUPABASE_SERVICE_ROLE_KEY=

# PayPal REST app credentials for server-to-server calls (webhook signature
# verification + fetching order details) -- SEPARATE from the
# NEXT_PUBLIC_PAYPAL_CLIENT_ID above, which is only for the client-side
# Hosted Buttons SDK. Create a REST app at
# https://developer.paypal.com/dashboard/applications -- use a Sandbox
# app while testing (see PAYPAL_API_BASE below), a Live app for production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook's ID, shown after you register it in the PayPal Developer
# Dashboard under the app -> Webhooks.
PAYPAL_WEBHOOK_ID=
# https://api-m.sandbox.paypal.com while testing;
# https://api-m.paypal.com once verified and ready for real orders.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Insights (see PROJECT_BIBLE.md 5n/5w) -- all SERVER-ONLY, add in Vercel as Sensitive ---
# Bearer secret for POST /api/insights/draft. You generate it: openssl rand -hex 32
INSIGHTS_DRAFT_API_KEY=
# Vercel Cron sends this as "Authorization: Bearer ..." to /api/cron/insights-draft
# (weekly drafting job). You generate it: openssl rand -hex 32
CRON_SECRET=
# Anthropic API key for the weekly drafting job (console.anthropic.com -> API Keys).
# Set a monthly spend limit in the Anthropic console too.
# Named ANTHROPIC_API_KEY2 because ANTHROPIC_API_KEY belongs to Korale.
ANTHROPIC_API_KEY2=

# --- Site chat assistant (src/features/chatbot, PROJECT_BIBLE 5ad) -- SERVER-ONLY, add in Vercel as Sensitive ---
# Anthropic API key used ONLY by POST /api/chat. Create it in its own Anthropic
# workspace with its own monthly spend limit, so chat traffic can never use up
# the News-drafting budget. Never falls back to ANTHROPIC_API_KEY (Korale) or
# ANTHROPIC_API_KEY2 (News drafts). Missing = chat shows "offline".
ANTHROPIC_API_KEY_CHAT=
# Salt for hashing visitor IPs (rate limiting; raw IPs are never stored).
# You generate it: openssl rand -hex 32
CHAT_IP_SALT=
# Local development only: CHAT_DEV_STUB=1 uses canned answers and an in-memory
# store instead of Anthropic + Supabase. Ignored in production builds.
# CHAT_DEV_STUB=1
