# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default -- never commit real keys.

# PayPal (see comment at top of src/components/PayPalButton.tsx for setup steps)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_HOSTED_BUTTON_ID=

# Supabase (only needed once the site has a dynamic feature -- not required to launch)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
